  <script>
    if (window.lucide) window.lucide.createIcons();

    // Carrossel automático contínuo via GPU (translate3d) + botões de controle
    (function(){
      var viewport = document.getElementById('carousel-viewport');
      var track = document.getElementById('product-carousel');
      var prevBtn = document.getElementById('carousel-prev');
      var nextBtn = document.getElementById('carousel-next');
      if (!track || !viewport) return;

      var originalSlides = Array.from(track.children);
      originalSlides.forEach(function(slide){
        var clone = slide.cloneNode(true);
        clone.setAttribute('aria-hidden', 'true');
        track.appendChild(clone);
      });

      var isPaused = false;
      var pos = 0;
      var speed = 0.65;

      function getHalfWidth(){
        return track.scrollWidth / 2;
      }

      function animateCarousel(){
        if (!isPaused) {
          pos -= speed;
          var half = getHalfWidth();
          if (Math.abs(pos) >= half) {
            pos = 0;
          }
          track.style.transform = 'translate3d(' + pos + 'px, 0, 0)';
        }
        requestAnimationFrame(animateCarousel);
      }

      viewport.addEventListener('mouseenter', function(){ isPaused = true; });
      viewport.addEventListener('mouseleave', function(){ isPaused = false; });
      viewport.addEventListener('touchstart', function(){ isPaused = true; }, { passive: true });
      viewport.addEventListener('touchend', function(){
        setTimeout(function(){ isPaused = false; }, 1200);
      }, { passive: true });

      prevBtn.addEventListener('click', function(){
        var step = originalSlides[0].offsetWidth + 18;
        var half = getHalfWidth();
        pos += step;
        if (pos > 0) pos = -half + step;
        track.style.transition = 'transform 0.35s ease';
        track.style.transform = 'translate3d(' + pos + 'px, 0, 0)';
        setTimeout(function(){ track.style.transition = 'none'; }, 360);
      });

      nextBtn.addEventListener('click', function(){
        var step = originalSlides[0].offsetWidth + 18;
        var half = getHalfWidth();
        pos -= step;
        if (Math.abs(pos) >= half) pos = 0;
        track.style.transition = 'transform 0.35s ease';
        track.style.transform = 'translate3d(' + pos + 'px, 0, 0)';
        setTimeout(function(){ track.style.transition = 'none'; }, 360);
      });

      requestAnimationFrame(animateCarousel);
    })();

    // Barra fixa mobile + ajuste de altura do botão do WhatsApp
    (function(){
      var bar = document.getElementById('sticky-buy');
      var wa = document.getElementById('whatsapp-float');
      var update = function(){
        var visible = window.scrollY > Math.max(420, window.innerHeight * .72);
        bar.classList.toggle('visible', visible);
        bar.setAttribute('aria-hidden', String(!visible));
        if (wa) wa.classList.toggle('lifted', visible);
      };
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    })();

    // Animação de revelação progressiva dos cards ao rolar a página
    (function(){
      var items = document.querySelectorAll('.color-card,.feature-card,.topic-card,.step,.bonus-card,.proof-slot,.offer-card');
      if (!('IntersectionObserver' in window)) return;

      items.forEach(function(item, index){
        item.classList.add('reveal-card');
        item.style.transitionDelay = (index % 3) * 90 + 'ms';
      });

      var observer = new IntersectionObserver(function(entries){
        entries.forEach(function(entry){
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -25px 0px' });

      items.forEach(function(item){
        observer.observe(item);
      });
    })();
  </script>
