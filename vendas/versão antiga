<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#1650f0">
  <meta name="description" content="Língua Portuguesa do 6º ao 9º ano: 250 páginas, mais de 1.000 questões com gabarito, planejamentos bimestrais, slides e mapas mentais em PDF e Word editável dentro de um app organizado.">
  <meta property="og:title" content="Biblioteca do Professor | Língua Portuguesa 6º ao 9º Ano">
  <meta property="og:description" content="Materiais de Língua Portuguesa alinhados à BNCC organizados por ano, bimestre e categoria em um app.">
  <title>Biblioteca do Professor | Língua Portuguesa 6º ao 9º Ano</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    :root{
      --blue:#1650f0;
      --blue-deep:#103ab5;
      --ink:#111216;
      --muted:#4c515b;
      --line:#e1e1e1;
      --paper:#f6f7f9;
      --purple:#7650e8;
      --orange:#f2a11b;
      --pink:#e83298;
      --cyan:#16a6dc;
      --green:#22a66b;
      --white-soft:#f5f5f7;
      --white-muted:#d4d4d8;
      --surface-light:#fafbfc;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth;scroll-padding-top:24px;overflow-x:hidden}
    body{margin:0;background:var(--surface-light);color:var(--ink);font-family:"Poppins",Arial,sans-serif;font-size:17px;line-height:1.65;-webkit-font-smoothing:antialiased;font-weight:400;overflow-x:hidden}
    p{max-width:68ch}
    a{color:inherit}
    :focus-visible{outline:3px solid #f2a11b;outline-offset:4px}

    /* Espaçamento lateral generoso e centralizado no desktop e mobile */
    .container{width:min(880px,calc(100% - 96px));margin-inline:auto}

    .brand-icon{display:grid;place-items:center;width:39px;height:39px;border-radius:12px;background:var(--blue);color:var(--white-soft);flex-shrink:0}

    /* Hero */
    .hero{padding:28px 0 64px;background:linear-gradient(180deg,#f3f5fa 0,var(--surface-light) 88%);text-align:center}
    .hero-kicker{display:inline-flex;align-items:center;gap:8px;border:1px solid #cdd8fa;border-radius:999px;background:var(--surface-light);padding:7px 14px;color:#2146ac;font-size:13.5px;font-weight:800;white-space:nowrap;max-width:100%}
    .hero h1{max-width:820px;margin:18px auto 24px;font-size:clamp(2rem,5.5vw,3.9rem);line-height:1.06;font-weight:800;color:#090a0c}
    .hero h1 em{font-family:"Poppins",Arial,sans-serif;font-style:normal;font-weight:800;letter-spacing:-.045em;color:var(--blue)}
    .video-frame{position:relative;width:min(100%,780px);margin:0 auto;overflow:hidden;aspect-ratio:16/9;border:3px solid #111216;border-radius:22px;background:linear-gradient(135deg,#111216 0%,#182443 55%,#1650f0 150%);box-shadow:10px 10px 0 var(--blue),0 24px 50px #101c3830}
    .video-placeholder{position:absolute;inset:0;display:grid;place-items:center;padding:20px;color:var(--white-soft)}
    .video-placeholder:before,.video-placeholder:after{content:"";position:absolute;border:1px solid #f5f5f724;border-radius:50%;pointer-events:none}
    .video-placeholder:before{width:52%;aspect-ratio:1;right:-8%;top:-45%}
    .video-placeholder:after{width:35%;aspect-ratio:1;left:-13%;bottom:-34%}
    .video-play{position:relative;z-index:1;display:grid;place-items:center;width:72px;height:72px;border-radius:50%;background:var(--white-soft);color:var(--blue);box-shadow:0 0 0 12px #f5f5f720;margin-inline:auto}
    .video-label{position:relative;z-index:1;margin:16px 0 0;color:var(--white-soft);font-size:16px;font-weight:700}
    .video-hint{position:absolute;z-index:1;left:16px;right:16px;bottom:14px;margin:0;color:var(--white-muted);font-size:13px}
    .hero-sub{max-width:700px;margin:32px auto 0;color:#343840;font-size:clamp(1rem,2vw,1.15rem);line-height:1.7}
    .hero-offer{display:flex;align-items:center;justify-content:center;gap:18px;flex-wrap:wrap;margin:24px auto 0}
    .price-old{color:#626773;text-decoration:line-through;font-size:17px;white-space:nowrap}
    .price-now{font-family:"Poppins",Arial,sans-serif;font-size:34px;font-weight:800;line-height:1;color:#090a0c;white-space:nowrap}
    .cta{display:inline-flex;min-height:56px;align-items:center;justify-content:center;gap:10px;border:2px solid var(--blue);border-radius:13px;background:var(--blue);padding:0 26px;color:var(--white-soft);text-decoration:none;font-size:17px;font-weight:700;box-shadow:0 5px 0 #0d329f;transition:transform .18s,background .18s,box-shadow .18s;white-space:nowrap}
    .cta:hover{transform:translateY(-2px);background:var(--blue-deep);box-shadow:0 7px 0 #0d329f}
    .microcopy{margin:12px auto 0;color:#50545d;font-size:14.5px}

    /* Faixa de Benefícios Rápidos com Carrossel Automático Contínuo (Desktop e Mobile) */
    .trust-strip{background:var(--blue);color:var(--white-soft);padding:14px 0;border-top:2px solid #090a0c;border-bottom:2px solid #090a0c;overflow:hidden;position:relative}
    .trust-marquee{display:flex;width:max-content;animation:marqueeScroll 22s linear infinite;will-change:transform}
    .trust-marquee:hover{animation-play-state:paused}
    .trust-group{display:flex;align-items:center;gap:36px;padding-right:36px}
    .trust-item{display:inline-flex;align-items:center;gap:8px;color:var(--white-soft);font-size:14.5px;font-weight:700;white-space:nowrap}
    .trust-item i{color:#ffd166;flex-shrink:0}
    @keyframes marqueeScroll{
      0%{transform:translate3d(0,0,0)}
      100%{transform:translate3d(-50%,0,0)}
    }

    /* Padrão de Seção */
    .section{padding:76px 0}
    .section-heading{max-width:700px;margin:0 auto 38px;text-align:center}
    .section-heading h2{margin:0;font-size:clamp(1.85rem,4.2vw,2.95rem);line-height:1.12;color:#0b0c0e}
    .section-heading p{margin:13px auto 0;color:#4c515b;font-size:17px}
    .eyebrow{margin:0 auto 10px;color:var(--blue);font-size:13.5px;font-weight:800;letter-spacing:.03em;text-transform:uppercase}

    /* Seção 1: Dor (Fundo Escuro #111216) */
    .pain-section{background:#111216;color:var(--white-soft)}
    .pain-section .eyebrow{color:#7da2ff}
    .pain-section .section-heading h2{color:var(--white-soft)}
    .pain-section .section-heading p{color:var(--white-muted)}
    .pain-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
    .color-card{position:relative;min-height:200px;overflow:hidden;border-radius:20px;padding:24px;color:var(--white-soft);box-shadow:0 12px 24px #0002;transition:transform .24s ease,box-shadow .24s ease}
    .color-card:hover{transform:translateY(-5px);box-shadow:0 19px 34px #0003}
    .color-card:after{content:"";position:absolute;width:130px;height:130px;right:-35px;bottom:-46px;border:18px solid #f5f5f724;border-radius:34px;transform:rotate(22deg)}
    .color-card .icon{display:grid;place-items:center;width:44px;height:44px;border-radius:13px;background:#0002;color:var(--white-soft)}
    .color-card h3{position:relative;z-index:1;margin:18px 0 7px;font-size:20.5px;line-height:1.2}
    .color-card p{position:relative;z-index:1;margin:0;font-size:15px;line-height:1.55}
    .color-blue{background:linear-gradient(135deg,#1650f0,#4776ff)}
    .color-purple{background:linear-gradient(135deg,#7147e6,#a064f2)}
    .color-orange{background:linear-gradient(135deg,#d97f04,#f5a618)}

    /* Seção 2: Carrossel Automático Contínuo do Produto por Dentro (Fundo Claro #f1f4f9) */
    .carousel-section{background:#f1f4f9;color:#111216;border-top:1px solid #dfe4ee;border-bottom:1px solid #dfe4ee;overflow:hidden}
    .carousel-viewport{overflow:hidden;padding:8px 0 18px;width:100%}
    .carousel-track{display:flex;gap:18px;width:max-content;will-change:transform}
    .carousel-slide{width:280px;flex-shrink:0;background:var(--surface-light);border:2px solid #111216;border-radius:20px;overflow:hidden;display:flex;flex-direction:column;box-shadow:6px 6px 0 var(--blue);transition:transform .24s ease}
    .carousel-slide:hover{transform:translateY(-4px)}
    .slide-preview{position:relative;aspect-ratio:16/10;background:linear-gradient(135deg,#1650f0,#2f66f5);padding:15px;display:flex;flex-direction:column;justify-content:space-between}
    .slide-badge{align-self:flex-start;display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;font-size:11.5px;font-weight:800;background:#11121655;color:var(--white-soft);white-space:nowrap}
    .slide-mockup{margin:auto;width:100%;max-width:215px;background:var(--surface-light);color:#111216;border-radius:10px;padding:11px;box-shadow:0 10px 20px #09184235;text-align:left}
    .slide-mockup-top{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #e5e7eb;padding-bottom:5px;margin-bottom:6px;font-size:9.5px;font-weight:800;color:var(--blue);white-space:nowrap}
    .slide-mockup-lines span{display:block;height:5.5px;border-radius:4px;background:#e2e8f0;margin-bottom:5px}
    .slide-mockup-lines span:nth-child(1){width:85%;background:#cbd5e1}
    .slide-mockup-lines span:nth-child(2){width:95%}
    .slide-mockup-lines span:nth-child(3){width:70%}
    .slide-mockup-tags{display:flex;gap:4px;margin-top:7px;flex-wrap:nowrap;overflow:hidden}
    .slide-mockup-tags em{font-style:normal;font-size:9px;font-weight:700;padding:2px 6px;border-radius:5px;background:#e9efff;color:var(--blue);white-space:nowrap}
    .slide-body{padding:18px;flex:1;display:flex;flex-direction:column}
    .slide-body h3{margin:0 0 7px;font-size:18px;color:#090a0c;line-height:1.22}
    .slide-body p{margin:0 0 14px;font-size:14px;color:#4c515b;line-height:1.5}
    .slide-specs{margin-top:auto;padding-top:11px;border-top:1px solid #e5e8ef;display:flex;flex-wrap:nowrap;gap:6px;overflow:hidden}
    .slide-spec-tag{font-size:11px;font-weight:700;color:#1642c1;background:#e9efff;padding:4px 8px;border-radius:7px;display:inline-flex;align-items:center;gap:4px;white-space:nowrap}
    .slide-spec-tag i{color:#16a34a;width:12px;height:12px;flex-shrink:0}
    .carousel-controls{display:flex;align-items:center;justify-content:space-between;margin-top:10px;gap:12px}
    .carousel-hint-text{font-size:13px;font-weight:600;color:#525866}
    .carousel-arrows{display:flex;gap:8px}
    .carousel-btn{width:40px;height:40px;border-radius:11px;border:2px solid #111216;background:var(--surface-light);color:#111216;display:grid;place-items:center;cursor:pointer;box-shadow:3px 3px 0 #111216;transition:transform .15s,background .15s,color .15s}
    .carousel-btn:hover{background:var(--blue);color:var(--white-soft);border-color:var(--blue)}

    /* Seção 3: Tudo que compõe o pacote (Cards Coloridos) */
    .feature-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}
    .feature-card{position:relative;display:flex;min-height:175px;flex-direction:column;align-items:flex-start;overflow:hidden;border-radius:20px;padding:24px;color:var(--white-soft);transition:transform .24s ease}
    .feature-card:hover{transform:translateY(-5px)}
    .feature-card:after{content:"";position:absolute;right:-30px;bottom:-55px;width:155px;height:155px;border:22px solid #f5f5f722;border-radius:50%}
    .feature-card h3{position:relative;z-index:1;margin:16px 0 6px;font-size:21px;line-height:1.18}
    .feature-card p{position:relative;z-index:1;margin:0;font-size:15.5px}
    .feature-card:nth-child(1){background:linear-gradient(135deg,#7044e8,#4e28bb)}
    .feature-card:nth-child(2){background:linear-gradient(135deg,#de8206,#f7ae18)}
    .feature-card:nth-child(3){background:linear-gradient(135deg,#e62a94,#c71776)}
    .feature-card:nth-child(4){background:linear-gradient(135deg,#12a4dc,#0879bf)}
    .feature-card:nth-child(5){background:linear-gradient(135deg,#1650f0,#3a6df5)}
    .feature-card:nth-child(6){background:linear-gradient(135deg,#1b965e,#137347)}
    .feature-icon{display:grid;place-items:center;width:42px;height:42px;border-radius:13px;background:#0002;color:var(--white-soft)}

    /* Seção 4: Grade Curricular 6º ao 9º ano (CARDS MELHORADOS E MAIS ROBUSTOS) */
    .curriculum-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
    .topic-card{background:var(--surface-light);border:2px solid #111216;border-radius:18px;padding:20px 22px;box-shadow:5px 5px 0 var(--blue);transition:transform .22s ease,box-shadow .22s ease;display:flex;flex-direction:column;gap:8px}
    .topic-card:hover{transform:translateY(-4px);box-shadow:7px 7px 0 #0d329f}
    .topic-top{display:flex;align-items:center;justify-content:space-between;gap:10px}
    .topic-header{display:flex;align-items:center;gap:12px}
    .topic-num{display:grid;place-items:center;width:36px;height:36px;border-radius:10px;background:var(--blue);color:var(--white-soft);font-size:15px;font-weight:800;flex-shrink:0}
    .topic-card h3{margin:0;font-size:18.5px;font-weight:800;line-height:1.2;color:#090a0c}
    .topic-pill{font-size:11px;font-weight:800;padding:3px 9px;border-radius:999px;background:#e9efff;color:var(--blue);white-space:nowrap}
    .topic-card p{margin:0;font-size:14.5px;color:#454a53;line-height:1.52;padding-left:48px}

    /* Seção 5: Como Funciona (Títulos dos passos bem grossos/destacados) */
    .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
    .step{border:2px solid #dfe1e5;border-radius:17px;background:var(--surface-light);padding:24px;box-shadow:6px 6px 0 #e1e1e1}
    .step-index{display:grid;place-items:center;width:40px;height:40px;border-radius:11px;background:var(--blue);color:var(--white-soft);font-family:"Poppins",Arial,sans-serif;font-weight:800;font-size:17px}
    .step h3{margin:18px 0 8px;font-size:21px;font-weight:800;letter-spacing:-.035em;line-height:1.2;color:#090a0c}
    .step p{margin:0;color:#454a53;font-size:15.5px;line-height:1.55}

    /* Faixa de Números COMPACTA E FINA (Imagem 1 reduzida) */
    .number-band{background:var(--blue);color:var(--white-soft);padding:22px 0;border-top:2px solid #090a0c;border-bottom:2px solid #090a0c}
    .number-band-inner{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;text-align:center;align-items:center}
    .stat-box{padding:2px 4px}
    .stat-box strong{display:block;font-size:clamp(1.45rem,3.8vw,2.4rem);font-weight:800;line-height:1.05;color:var(--white-soft);white-space:nowrap}
    .stat-box span{display:block;margin-top:3px;font-size:clamp(11.5px,2.2vw,14px);font-weight:500;color:#e4e4e7;line-height:1.3}

    /* Seção 6: BÔNUS EXCLUSIVOS */
    .bonus-section{background:#111216;color:var(--white-soft)}
    .bonus-section .eyebrow{color:#ffd166}
    .bonus-section .section-heading h2{color:var(--white-soft)}
    .bonus-section .section-heading p{color:var(--white-muted)}
    .bonus-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
    .bonus-card{background:var(--surface-light);color:#111216;border-radius:20px;overflow:hidden;border:2px solid #ffd166;display:flex;flex-direction:column;box-shadow:8px 8px 0 #ffd16635}
    .bonus-banner{background:#ffd166;color:#111216;padding:10px 18px;display:flex;align-items:center;justify-content:space-between;font-size:12.5px;font-weight:900;letter-spacing:.03em;text-transform:uppercase}
    .bonus-free-pill{background:#111216;color:#ffd166;padding:3px 9px;border-radius:6px;font-size:11px;font-weight:800}
    .bonus-body{padding:22px;flex:1;display:flex;flex-direction:column}
    .bonus-icon-row{display:flex;align-items:center;gap:12px;margin-bottom:12px}
    .bonus-icon{display:grid;place-items:center;width:44px;height:44px;border-radius:12px;background:#e9efff;color:var(--blue);flex-shrink:0}
    .bonus-body h3{margin:0;font-size:19.5px;font-weight:800;color:#090a0c;line-height:1.2}
    .bonus-body p{margin:0 0 18px;font-size:14.5px;color:#454a53;line-height:1.55}
    .bonus-price-box{margin-top:auto;padding-top:12px;border-top:1px dashed #cbd5e1;display:flex;align-items:center;justify-content:space-between;font-size:13px}
    .bonus-price-box s{color:#6b7280;font-weight:600}
    .bonus-price-box strong{color:#15803d;font-weight:800;font-size:15px}
    .bonus-total-bar{margin-top:26px;background:#1a1d26;border:1px dashed #ffd166;border-radius:14px;padding:14px 20px;text-align:center;color:var(--white-soft);font-size:15px}
    .bonus-total-bar strong{color:#ffd166;font-weight:800}

    /* Provas Sociais */
    .proof-section{background:#f0f2f5}
    .proof-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
    .proof-slot{position:relative;display:flex;min-height:220px;flex-direction:column;align-items:center;justify-content:center;overflow:hidden;border:2px dashed #9da7bb;border-radius:20px;background:var(--surface-light);padding:24px;text-align:center;color:#20232a}
    .proof-slot:nth-child(1){box-shadow:inset 0 7px 0 #1650f0}
    .proof-slot:nth-child(2){box-shadow:inset 0 7px 0 #7650e8}
    .proof-slot:nth-child(3){box-shadow:inset 0 7px 0 #f2a11b}
    .proof-slot .upload-icon{display:grid;place-items:center;width:48px;height:48px;margin-bottom:13px;border-radius:15px;background:#e9efff;color:var(--blue)}
    .proof-slot strong{font-size:16.5px;font-weight:800}
    .proof-slot span{max-width:250px;margin-top:6px;color:#545963;font-size:14.5px}
    .proof-note{margin:18px auto 0;text-align:center;color:#4c515b;font-size:14px}

    /* Oferta */
    .offer-section{background:#111216;color:var(--white-soft)}
    .offer-card{display:grid;grid-template-columns:1.22fr .78fr;max-width:880px;margin:auto;overflow:hidden;border:2px solid #090a0c;border-radius:24px;background:var(--surface-light);color:#111216;box-shadow:12px 12px 0 var(--blue)}
    .offer-copy{padding:32px}
    .offer-copy h2{margin:0;font-size:clamp(1.85rem,3.6vw,2.6rem);font-weight:800;letter-spacing:-.035em;line-height:1.1;color:#090a0c}
    .offer-copy p{color:#434750;font-size:16px}
    .year-pills{display:flex;flex-wrap:nowrap;gap:6px;margin:16px 0;overflow-x:auto}
    .year-pill{font-size:12px;font-weight:800;padding:4px 10px;border-radius:999px;background:#e9efff;color:var(--blue);white-space:nowrap}
    .offer-copy ul{margin:18px 0 0;padding:0;list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:10px 14px}
    .offer-copy li{display:flex;align-items:center;gap:8px;color:#1f232b;font-size:14.5px;font-weight:600}
    .offer-price{display:flex;flex-direction:column;justify-content:center;align-items:flex-start;background:#e8eaee;padding:28px;border-left:1px solid #d5d8df}
    .offer-price-label{font-size:13px;font-weight:800;color:var(--blue);text-transform:uppercase;letter-spacing:.03em;white-space:nowrap}
    .offer-price .price-now{margin:6px 0 8px;font-size:42px;font-weight:800}
    .offer-price-sub{font-size:14px;color:#4c515b;margin:0 0 18px;line-height:1.48}
    .offer-price .cta{width:100%;padding-inline:15px}
    .offer-guarantee{display:flex;align-items:center;gap:7px;margin-top:13px;font-size:13px;font-weight:700;color:#4c515b;white-space:nowrap}

    /* FAQ */
    .faq-list{max-width:780px;margin:auto;border-top:1px solid #d8dbe1}
    .faq-item{border-bottom:1px solid #d8dbe1}
    .faq-item summary{position:relative;cursor:pointer;list-style:none;padding:19px 40px 19px 0;font-size:17px;font-weight:500;color:#383d47;line-height:1.42}
    .faq-item summary::-webkit-details-marker{display:none}
    .faq-item summary:after{content:"+";position:absolute;right:5px;top:14px;color:var(--blue);font-size:25px;font-weight:500}
    .faq-item[open] summary:after{content:"−"}
    .faq-item p{margin:0;padding:0 26px 19px 0;color:#4c515b;font-size:15.5px;font-weight:400;line-height:1.62}

    /* Fechamento */
    .closing{background:#e8eaee;text-align:center}
    .closing h2{max-width:700px;margin:0 auto;font-size:clamp(1.9rem,4.5vw,3.1rem);line-height:1.1}
    .closing p{max-width:620px;margin:13px auto 0;color:#41464f;font-size:17px}
    .sticky-buy{position:fixed;z-index:40;right:0;bottom:0;left:0;display:flex;align-items:center;justify-content:space-between;gap:12px;border-top:1px solid #d5d8df;background:var(--surface-light);padding:10px 18px calc(10px + env(safe-area-inset-bottom));box-shadow:0 -8px 24px #11121618;transform:translateY(110%);transition:transform .22s ease}
    .sticky-buy.visible{transform:translateY(0)}

    /* Botão Flutuante de WhatsApp */
